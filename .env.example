# Входящий вебхук Битрикс24 (права: crm, lists). Пример:
# B24_WEBHOOK=https://crm.rusir38.ru/rest/123/abcdef1234567890/
B24_WEBHOOK=

# Необязательно: если автопоиск ошибётся, задайте вручную
# POSITIONS_IBLOCK_ID=15
# OFFERS_IBLOCK_ID=
# REQUEST_ENTITY_TYPE_ID=183
# LISTS_IBLOCK_TYPE_ID=lists

# Проверка SSL портала (0 — если на портале самоподписанный сертификат)
B24_VERIFY_SSL=1

# Сколько страниц (по 50 записей) запрашивать за один batch. Уменьшите, если сервер обрывает ответы
# B24_PAGES_PER_BATCH=10

# Пауза между окнами загрузки, сек (бережём портал)
# B24_PAUSE=0.3
# Лимит памяти контейнера
# RIAI_MEM=700m
